<mod name="UnderwaterHitViewer" version="1.0.0" priority="0">
  <requires installer="&gt;=1.0.0"/>

  <!-- Unbound 2 view; the .unbound file is auto-discovered, only the battle mount is needed. -->
  <ubMountInBattle unbound="2"
                   rootElementId="UHV_UnderwaterHitViewer"
                   name="unbound2UnderwaterHitViewer"
                   hitTest="false"
                   after="MainHud"/>
</mod>
